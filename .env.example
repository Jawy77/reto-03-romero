# Copia este archivo como .env y completa los valores. El archivo .env nunca se sube al repositorio.

# Proveedor del modelo: kimi | anthropic | simulado.
# Vacío: usa kimi si hay KIMI_API_KEY, anthropic si hay ANTHROPIC_API_KEY y, si no hay ninguna,
# arranca en modo simulado (sin modelo de lenguaje).
LLM_PROVIDER=

# Claves. Solo las lee el backend; nunca llegan al front, a los logs ni a las respuestas de la API.
KIMI_API_KEY=
ANTHROPIC_API_KEY=

# Endpoint compatible con Chat Completions para Kimi (Moonshot AI).
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Modelo. Vacío: kimi-k2-turbo-preview con kimi, claude-opus-5-5 con anthropic.
LLM_MODEL=
# Solo anthropic: nivel de esfuerzo (low | medium | high | xhigh | max).
LLM_EFFORT=low
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_MS=90000

# Topes de costo y de uso.
MAX_ITERACIONES=25
MAX_TOKENS_SESION=200000
MAX_TOKENS_DIA=2000000
MENSAJES_POR_MINUTO=20

# Puerto interno del servidor y puerto publicado por docker compose.
PORT=3000
PUERTO_PUBLICO=3000
