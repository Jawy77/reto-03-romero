# Copia este archivo como .env y completa los valores. El archivo .env nunca se sube al repositorio.

# Proveedor del modelo: anthropic | simulado.
# Vacío: usa anthropic si hay ANTHROPIC_API_KEY; si no, arranca en modo simulado (sin modelo).
LLM_PROVIDER=

# Clave del proveedor. Solo la lee el backend; nunca llega al front, a los logs ni a las respuestas de la API.
ANTHROPIC_API_KEY=

# Modelo y nivel de esfuerzo (low | medium | high | xhigh | max).
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_MS=90000

# Topes de costo y de uso.
MAX_ITERACIONES=25
MAX_TOKENS_SESION=200000
MAX_TOKENS_DIA=2000000
MENSAJES_POR_MINUTO=20

# Puerto interno del servidor y puerto publicado por docker compose.
PORT=3000
PUERTO_PUBLICO=3000
